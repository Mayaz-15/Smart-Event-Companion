<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SmartEventCompanion" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_purple</item>
        <item name="colorPrimaryVariant">@color/dark_purple</item>
        <item name="colorOnPrimary">@color/text_white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/primary_purple</item>
        <item name="colorSecondaryVariant">@color/primary_purple</item>
        <item name="colorOnSecondary">@color/black_bg</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Background Color -->
        <item name="android:windowBackground">@color/black_bg</item>
    </style>
</resources>